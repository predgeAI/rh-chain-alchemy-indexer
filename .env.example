# Copy to .env and fill in. .env is git-ignored; never commit it.
#
# ALCHEMY_API_KEY: the key of an Alchemy app with Robinhood Chain Mainnet enabled (the Free plan is enough).
# RPC_URL: the app's HTTPS endpoint WITHOUT the key. The script appends the key itself and never prints it.
ALCHEMY_API_KEY=your_alchemy_api_key
RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2
